# Copy to .env and fill in the secrets.  The scripts under benchmark/, planner/, baselines/ and examples/yelp/
# read this file from the repository root (a value already in the environment wins).

# The model behind the planner and the baselines: any OpenAI-compatible chat endpoint.
YODB_LLM_ENDPOINT=https://openai.rc.asu.edu/v1
YODB_LLM_MODEL=qwen3-235b-a22b
OPENAI_API_KEY=

# The Yelp data layer: the owner connection used to load it (examples/yelp/load.py, benchmark/build.py) ...
YELP_DSN=host=localhost port=55434 dbname=yelp user=postgres password=postgres
# ... and the read-only role YoDb and the baselines query through.
YODB_CONN_YELP=host=localhost port=55434 dbname=yelp user=yodb_ro password=yodb_ro
