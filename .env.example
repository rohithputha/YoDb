# Copy to .env and fill in the secrets.  The scripts under benchmark/, planner/, baselines/ and examples/yelp/
# read this file from the repository root (a value already in the environment wins).

# The model behind the planner and the baselines: any OpenAI-compatible chat endpoint.
YODB_LLM_ENDPOINT=https://openai.rc.asu.edu/v1
YODB_LLM_MODEL=qwen3-235b-a22b
OPENAI_API_KEY=

# The Yelp data layer: the owner connection used to load it (examples/yelp/load.py, benchmark/build.py) ...
YELP_DSN=host=localhost port=55434 dbname=yelp user=postgres password=postgres
# ... and the read-only role YoDb and the baselines query through.
YODB_CONN_YELP=host=localhost port=55434 dbname=yelp user=yodb_ro password=yodb_ro

# The Yelp Open Dataset: where the three JSON files live (fetched there when missing), and the download link from
# Yelp's licence form (https://business.yelp.com/data/resources/open-dataset/) if you want load.py to fetch it.
YELP_DATA=~/yelp
YELP_DATASET_URL=

# The container the scripts start (scripts/pg.sh): port and runtime are detected; set these only to override.
# YODB_PG_PORT=55434            # must match the two connection strings above
# YODB_PG_RUNTIME=apptainer     # docker | podman | apptainer (detected when unset)
# YODB_PG_HOME=/scratch/<asurite>/yodb-pg      # Apptainer: where the image and the data directory live ($SCRATCH/yodb-pg)
# YODB_PG_IMAGE_TAR=/scratch/<asurite>/yodb-pg/yodb-age.tar   # Apptainer: a `docker save` archive to build the image from
# YODB_EMBED_THREADS=16         # CPU threads for the embeddings (default: all cores)
# YODB_EMBED_DEVICE=auto        # cpu | cuda | auto (a GPU when onnxruntime-gpu sees one: pip install fastembed-gpu)
